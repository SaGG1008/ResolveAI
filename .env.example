# ResolveAI Environment Configuration Template
# Copy this file to .env and insert your real API keys.

# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Primary LLM for Triage, Investigation, and Root-Cause Diagnosis
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Fallback LLM Provider (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Set to "false" to use live LLM API calls, or "true" for deterministic hackathon demo mode
ENABLE_MOCK_LLM=false

# ============================================================================
# Server & Environment Settings
# ============================================================================
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=sqlite:///./backend/resolveai.db
